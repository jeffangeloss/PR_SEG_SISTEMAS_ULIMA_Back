# Plantilla de variables de entorno de la variante de LABORATORIO de ULima++ (ver LABORATORIO.md).
#
# Copia este archivo a .env.laboratorio, que git ignora:
#
#   cp .env.laboratorio.example .env.laboratorio
#
# Todos los valores son de laboratorio: la base es un Postgres local en 127.0.0.1:5433 y las
# claves no sirven fuera de esta máquina. No crees un .env en la raíz; los scripts de
# scripts/laboratorio se niegan a correr si existe, porque bun y dotenv lo cargarían solos.
#
# Las primeras variables son las de src/config/env.ts, en su mismo orden. Las LAB_* del final
# solo las leen los scripts y el seed del laboratorio; el backend las ignora.

# Base local del laboratorio. Usuario, clave, puerto y nombre tienen que coincidir con LAB_DB_*.
DATABASE_URL=postgres://ulimapp_lab:lab-bd-2026@127.0.0.1:5433/ulimapp_lab

# Secreto de los JWT del laboratorio. No es el de ningún otro entorno.
JWT_SECRET=laboratorio-jwt-no-es-de-produccion

JWT_EXPIRES_IN=86400

PORT=3000

# development: sin Resend, el código de restablecimiento sale en la consola con [DEV ONLY].
NODE_ENV=development

# Vacío deja CORS abierto (*), igual que en v2.1.0.
CORS_ORIGINS=

# Vacía: no se envían correos.
RESEND_API_KEY=

# Las tres vacías: no hay fotos de perfil y la app muestra iniciales.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_FROM=ULima++ Laboratorio <sin-envio@laboratorio.test>

RESEND_REPLY_TO=

PASSWORD_RESET_MAX_PER_HOUR=3

# Las cuatro vacías: el chat no firma tokens de Firebase y no funciona.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# El arranque exige un valor. Con este, ficticio, el chatbot responde error y el motivo del test
# de especialidad usa sus plantillas.
COHERE_API_KEY=laboratorio-sin-cohere

CHATBOT_RATE_LIMIT=20

# --- Solo scripts/laboratorio y src/db/seed/laboratorio.ts ---

# Directorio de datos de Postgres, fuera de los repositorios. Vacío, los scripts usan la carpeta
# .lab junto a la que contiene este repositorio. Si pones una ruta, que sea absoluta.
LAB_DIR=
# Binarios de Postgres 16 de Homebrew.
LAB_PG_BIN=/opt/homebrew/bin
LAB_PG_PORT=5433
LAB_DB_NAME=ulimapp_lab
LAB_DB_USER=ulimapp_lab
LAB_DB_PASSWORD=lab-bd-2026

# Contraseñas de las cuentas sintéticas: una para los doce alumnos (20990001 a 20990012) y otra
# para las dos cuentas docentes (lab.docente1 y lab.jp1). Se fijan al crear la base.
LAB_PASSWORD_ALUMNO=Alumno.Lab.2026
LAB_PASSWORD_DOCENTE=Docente.Lab.2026
